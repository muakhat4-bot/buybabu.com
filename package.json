{
  "name": "villex-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "description": "Buy Babu Multi-Vendor Marketplace Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@villex/customer-marketplace --filter=@villex/vendor-portal --filter=@villex/admin-portal --filter=@villex/api-server --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "clean": "turbo run clean && npx rimraf node_modules **/node_modules .turbo",
    "deploy": "deploy.bat"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "next": "^15.5.28",
    "handlebars": "^4.7.10",
    "proxy-addr": "^2.0.8",
    "multer": "^2.5.0",
    "body-parser": "^2.4.0",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0"
  }
}
